{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annona",
  "version": "0.1.2",
  "identifier": "com.akaion.annona",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Annona",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "deb",
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "copyright": "\u00a9 2026 Akaion",
    "shortDescription": "Annona \u2014 the sovereign execution kernel",
    "longDescription": "Annona decides where each step of an agent run may execute \u2014 your GPU, your cluster, or a frontier API \u2014 enforces the decision, and records it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/annona"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "127.0.0.1"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": "^http://localhost:7070/\\?signin=1$"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/akaion-ai/annona/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCM0Q4N0EzODBGMDdENDQKUldSRWZmQ0FvNGM5eSs5c1JCMVNONzBPZWVNbEtpQ0ZFZzhJT1JpUGZpcVppVkhWanhKMkRYL0YK"
    }
  }
}
